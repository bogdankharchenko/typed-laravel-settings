{
  "name": "bogdankharchenko/typed-laravel-settings",
  "description": "Strongly typed laravel settings.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "illuminate/support": "^11.0|^12.0|^13.0",
    "illuminate/database": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0|^12.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "BogdanKharchenko\\Settings\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BogdanKharchenko\\Settings\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "BogdanKharchenko\\Settings\\Providers\\SettingsServiceProvider"
      ]
    }
  }
}
